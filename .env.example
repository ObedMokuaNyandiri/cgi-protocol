# ─────────────────────────────────────────────────────────────
# CGI Protocol — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── API Server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── Security ──────────────────────────────────────────────────
# Path to JSON file containing API keys (see auth/api_keys.example.json)
# Leave empty to disable API key authentication (dev only!)
API_KEYS_FILE=auth/api_keys.json

# Requests per minute per API key
RATE_LIMIT_RPM=30

# Comma-separated CORS origins
CORS_ORIGINS=["*"]

# Maximum prompt length in characters
MAX_PROMPT_LENGTH=4096

# ── Worker / Inference ────────────────────────────────────────
MODEL_PATH=./models/models/qwen_0_5b
MODEL_ID=qwen_0_5b
WORKER_TIMEOUT_SECONDS=180
DEFAULT_MAX_TOKENS=200
DEFAULT_SEED=42
DEFAULT_TEMPERATURE=0.8

# ── Healthcare / HIPAA ────────────────────────────────────────
# Data classification for inferences: PHI | PII | PUBLIC
DEFAULT_DATA_CLASSIFICATION=PUBLIC

# Audit log retention in days (HIPAA requires 2190 = 6 years)
AUDIT_RETENTION_DAYS=2190

# Enable encryption for PHI fields in the ledger
ENABLE_PHI_ENCRYPTION=false

# 32-byte hex key for PHI encryption (generate with: python -c "import os; print(os.urandom(32).hex())")
PHI_ENCRYPTION_KEY=

# ── Enclave ───────────────────────────────────────────────────
# software = cryptographic signing without hardware TEE (free tier)
# nitro    = AWS Nitro Enclave (requires compatible EC2 instance)
ENCLAVE_MODE=software
ENCLAVE_ID=cgi-software-enclave-1

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─────────────────────────────────────────────────────────────
# CGI Protocol — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── API Server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── Security ──────────────────────────────────────────────────
# Path to JSON file containing API keys
# Run: python auth/keygen.py --api-key "My Org" to generate
API_KEYS_FILE=auth/api_keys.json

# Requests per minute per API key
RATE_LIMIT_RPM=30

# CORS Origins — restrict to your frontend domain in production!
# SECURITY: Keep empty ([]) to deny all cross-origin requests (safe default)
# Dev example: CORS_ORIGINS=["http://localhost:3000"]
CORS_ORIGINS=[]

# Maximum prompt length in characters
MAX_PROMPT_LENGTH=4096

# Passphrase for the governance private key
PRIVATE_KEY_PASSPHRASE=

# ── Licensing ─────────────────────────────────────────────────
# ENFORCE  = hard fail if license missing/invalid (production)
# WARN     = log warning but start anyway (dev/testing)
# DISABLED = skip all license checks (open-source/self-hosted)
LICENSE_ENFORCEMENT=DISABLED
LICENSE_KEY_PATH=
ISSUER_PUBLIC_KEY_PATH=

# ── AI Backend Selection ──────────────────────────────────────
# Choose ONE backend. Set AI_BACKEND_TYPE to one of:
#
#   Cloud APIs:
#     gemini_native        Google Gemini (Recommended default)
#     openai_compatible    OpenAI / LM Studio / any OpenAI-spec API
#     anthropic            Anthropic Claude
#     azure_openai         Azure OpenAI Service
#     groq                 Groq (ultra-fast Llama/Mixtral)
#     mistral              Mistral AI
#     together_ai          Together AI
#     huggingface_api      HuggingFace Inference API

#     cohere               Cohere Command R / R+
#
#   Local / Self-Hosted:
#     ollama_local         Ollama  (ollama serve)
#     vllm_local           vLLM server (pip install vllm)
#     llamacpp_server      llama.cpp HTTP server
#     huggingface_local    HuggingFace local model (subprocess)

AI_BACKEND_TYPE=gemini_native

# Optional: custom system prompt injected by all adapters
# AI_SYSTEM_PROMPT=You are a controlled inference engine. Answer precisely.

# ── Google Gemini ─────────────────────────────────────────────
# AI_BACKEND_TYPE=gemini_native
# Get your key at: https://aistudio.google.com/app/apikey
AI_API_KEY=
MODEL_ID=gemini-2.5-flash

# Available Gemini models:
# gemini-2.5-flash  gemini-2.5-pro  gemini-1.5-pro-latest  gemini-1.5-flash-latest

# ── OpenAI ────────────────────────────────────────────────────
# AI_BACKEND_TYPE=openai_compatible
# AI_ENDPOINT_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# MODEL_ID=gpt-4o-mini

# Available OpenAI models:
# gpt-4o  gpt-4o-mini  gpt-4-turbo  gpt-3.5-turbo

# ── Anthropic Claude ──────────────────────────────────────────
# AI_BACKEND_TYPE=anthropic
# AI_API_KEY=sk-ant-...
# MODEL_ID=claude-sonnet-4-5
# Get key: https://console.anthropic.com/

# Available Claude models:
# claude-opus-4-5  claude-sonnet-4-5  claude-haiku-3-5
# claude-3-5-sonnet-20241022  claude-3-5-haiku-20241022

# ── Azure OpenAI ──────────────────────────────────────────────
# AI_BACKEND_TYPE=azure_openai
# AI_API_KEY=<key from Azure portal>
# AZURE_OPENAI_RESOURCE=my-company-openai
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-deployment
# AZURE_API_VERSION=2024-02-01

# ── Groq (ultra-fast inference) ───────────────────────────────
# AI_BACKEND_TYPE=groq
# AI_API_KEY=gsk_...
# MODEL_ID=llama-3.3-70b-versatile
# Get key: https://console.groq.com/

# Available Groq models:
# llama-3.3-70b-versatile  llama-3.1-8b-instant  mixtral-8x7b-32768  gemma2-9b-it

# ── Mistral AI ────────────────────────────────────────────────
# AI_BACKEND_TYPE=mistral
# AI_API_KEY=<Mistral key>
# MODEL_ID=mistral-large-latest
# Get key: https://console.mistral.ai/

# ── Together AI ───────────────────────────────────────────────
# AI_BACKEND_TYPE=together_ai
# AI_API_KEY=<Together key>
# MODEL_ID=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Get key: https://api.together.ai/

# ── HuggingFace Inference API ─────────────────────────────────
# AI_BACKEND_TYPE=huggingface_api
# AI_API_KEY=hf_...
# MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2
# Get token: https://huggingface.co/settings/tokens



# ── Cohere ────────────────────────────────────────────────────
# AI_BACKEND_TYPE=cohere
# AI_API_KEY=<Cohere key>
# MODEL_ID=command-r-plus-08-2024
# Get key: https://dashboard.cohere.com/api-keys

# ── Ollama (local) ────────────────────────────────────────────
# Install: https://ollama.ai | Start: ollama serve | Pull: ollama pull llama3.2
# AI_BACKEND_TYPE=ollama_local
# AI_ENDPOINT_URL=http://localhost:11434
# MODEL_ID=llama3.2

# ── vLLM (local server) ───────────────────────────────────────
# pip install vllm
# vllm serve meta-llama/Llama-3.2-3B-Instruct --port 8000
# AI_BACKEND_TYPE=vllm_local
# AI_ENDPOINT_URL=http://localhost:8000/v1
# MODEL_ID=meta-llama/Llama-3.2-3B-Instruct

# ── llama.cpp HTTP server (local) ─────────────────────────────
# ./llama-server -m model.gguf --port 8080
# AI_BACKEND_TYPE=llamacpp_server
# AI_ENDPOINT_URL=http://localhost:8080/v1
# MODEL_ID=local-model

# ── HuggingFace Local (subprocess, legacy) ────────────────────
# AI_BACKEND_TYPE=huggingface_local
# MODEL_PATH=./models/models/qwen_0_5b
# MODEL_ID=qwen_0_5b

# ── Worker Settings ───────────────────────────────────────────
WORKER_TIMEOUT_SECONDS=180
DEFAULT_MAX_TOKENS=200
DEFAULT_SEED=42
DEFAULT_TEMPERATURE=0.8

# ── Audit & Data Classification ───────────────────────────────
# Data classification: PUBLIC | CONFIDENTIAL | PII | PRIVILEGED | CLASSIFIED
DEFAULT_DATA_CLASSIFICATION=PUBLIC

# Audit log retention in days (HIPAA requires 2190 = 6 years)
AUDIT_RETENTION_DAYS=2190

# Enable AES-256-GCM encryption for sensitive fields in the ledger
ENABLE_SENSITIVE_ENCRYPTION=false

# 32-byte hex key (generate with: python -c "import os; print(os.urandom(32).hex())")
SENSITIVE_ENCRYPTION_KEY=

# ── Blockchain Anchoring (Bitcoin / OpenTimestamps) ───────────
ANCHOR_ENABLED=true
ANCHOR_INTERVAL_SECONDS=3600

# ── Enclave ───────────────────────────────────────────────────
# software = cryptographic signing without hardware TEE (standard)
ENCLAVE_MODE=software
ENCLAVE_ID=cgi-software-enclave-1

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# Use Amazon Linux 2023 for native compatibility with AWS Nitro Enclaves
FROM amazonlinux:2023

# Install system dependencies
RUN yum update -y && \
    yum install -y \
    python3.11 \
    python3.11-pip \
    gcc \
    python3.11-devel \
    aws-nitro-enclaves-cli-devel \
    iproute \
    && yum clean all

# Ensure python commands map to python3.11
RUN ln -sf /usr/bin/python3.11 /usr/bin/python && \
    ln -sf /usr/bin/pip3.11 /usr/bin/pip

# Set working directory
WORKDIR /app

# The enclave needs libnsm.so to generate physical attestations
# Normally provided by aws-nitro-enclaves-cli-devel
# Verify it exists or symlink it if necessary
RUN ls -la /usr/lib64/libnsm.so || echo "libnsm.so not found in standard lib path, may need custom compiling"

# Copy the CGI Protocol codebase
# (Assuming the build context is the repository root)
COPY . /app/

# Install python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Run the aggregator script. 
# In a real enclave, this communicates over vsock.
# We set an env var to tell the python code it's in a physical enclave.
ENV PHYSICAL_NITRO_ENCLAVE=1
ENV PYTHONUNBUFFERED=1

# Expose vsock port if applicable (documentation purposes)
# EXPOSE 5000 

ENTRYPOINT ["python", "enclave/aggregator.py"]

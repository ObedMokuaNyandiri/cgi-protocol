pragma solidity ^0.8.20;

/**
 * @title ICGIVerifier
 * @dev Interface for the auto-generated ZK-SNARK verifier.
 * Whether generated by EZKL (Halo2) or SnarkJS (Groth16), the verifier must conform
 * to this interface so the CGIRegistry can independently verify the proofs.
 */
interface ICGIVerifier {
    /**
     * @notice Verifies a zero-knowledge proof against a set of public signals.
     * @param proof The cryptographic proof bytes (e.g., Groth16 pi_a, pi_b, pi_c or Halo2 KZG proof).
     * @param pubSignals The array of public signals (e.g., [previous_root, expected_output_hash, new_root]).
     * @return bool True if the proof is mathematically valid, false otherwise.
     */
    function verifyProof(
        bytes calldata proof,
        uint256[] calldata pubSignals
    ) external view returns (bool);
}
